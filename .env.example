# Copy to .env.local (never committed) and fill in.

# ── Images (scripts/generate-images.mjs) ─────────────────────────────────────
# Google AI Studio key with access to Nano Banana Pro (Gemini 3 Pro Image)
GEMINI_API_KEY=

# Optional overrides
# NANO_BANANA_MODEL=gemini-3-pro-image-preview
# IMAGE_SIZE=2K
# CONCURRENCY=2

# ── Wellness contacts database (server/wellness-db.mjs) ──────────────────────
# SQLite file for the name + email saved at sign-up (insert if new, update if known).
# Created, with its folder, on first save. Default: data/wellness.db
# WELLNESS_DB=data/wellness.db

# Standalone API (npm run wellness-api): port and any extra allowed origins
# WELLNESS_PORT=8791
# WELLNESS_ALLOWED_ORIGINS=https://example.com

# Build-time: where the hosted app sends the contact. Without it, only local
# dev/preview (which mount /api/wellness themselves) save contacts.
# VITE_WELLNESS_API=https://your-host/api/wellness
